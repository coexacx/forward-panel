[Unit]
Description=Vistart Forward panel
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=forward-panel
Group=forward-panel
WorkingDirectory=/opt/forward-panel
ExecStart=/opt/forward-panel/bin/controller-linux-__ARCH__ -config /opt/forward-panel/state/controller.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/forward-panel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=384M
TasksMax=128
[Install]
WantedBy=multi-user.target
